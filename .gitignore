# Website-only repository: keep local tools and working files off GitHub.
/*
!/.gitignore
!/.github/
!/index.html
!/theme.css
!/directory.js
!/rankings.js
!/player-power.js
!/merge.js
!/vault.js
!/README.md
!/data/
/data/*
# Only the encrypted bundle is published; plain data stays local (scripts/lfdata.py).
!/data/site.enc.json
