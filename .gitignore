# Website-only repository: keep local tools and working files off GitHub.
/*
!/.gitignore
!/.github/
!/index.html
!/theme.css
!/directory.js
!/rankings.js
!/player-power.js
!/merge.js
!/vault.js
!/profiles.js
!/server.js
!/img/
!/README.md
!/favicon-32.png
!/apple-touch-icon.png
!/logo.png
!/hero-radar.png
!/data/
/data/*
# Only the encrypted bundle is published; plain data stays local (scripts/lfdata.py).
!/data/site.enc.json
!/data/sample.json
# Profiles (Beta): encrypted bundles only (scripts/profiles.py).
!/data/profiles.enc.json
!/data/profiles-detail.enc.json
# Server tab: encrypted bundle only (scripts/profiles.py).
!/data/server.enc.json
!/data/dimension.enc.json
